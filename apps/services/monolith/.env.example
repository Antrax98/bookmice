#db
DB_HOST=<ip de la base de datos> <string>
DB_PORT=<puerto de la base de datos> <number>
DB_USER=<usuario de la base de datos> <string>
DB_PASS=<contraseña del usuario de la base de datos> <string>
DB_NAME=<nombre de la base de datos> <string>
# Schema de Postgres donde viven las tablas. Opcional: vacio = `public`.
# Solo minusculas, digitos y guiones bajos. Se crea solo al arrancar o al
# migrar; no hace falta crearlo a mano.
DB_SCHEMA=<schema de postgres> <string>

#app
PORT=<puerto de la aplicacion> <number>
NODE_ENV=<entorno de ejecucion: development | production> <string>

#auth
# Clave HS256. MINIMO 32 bytes, y la app no arranca sin tanto.
# Genérala con: openssl rand -base64 32
JWT_SECRET=<secreto JWT de al menos 32 bytes> <string>

# OJO: @nestjs/authentication cuenta esto en MILISEGUNDOS o como string
# ('15m', '30d', '14d'). NO en segundos como hacia @nestjs/jwt. Un numero
# desnudo son milisegundos: 3600 son 3.6 segundos, no una hora, y solo sale un
# aviso al arrancar.
JWT_EXPIRES_IN=<duracion del access token, default=1h> <string>

# Vida del refresh token y de su familia (rotaciones encadenadas).
REFRESH_TOKEN_TTL=<vida de un refresh token, default=30d> <string>

# Coste de scrypt, en base 2. 17 son 128 MiB por hash: el valor de produccion.
# En desarrollo y test baja a 10 (~1 MiB) automaticamente, para que los tests
# no tarden un segundo ni se coman la memoria. Ponerlo aqui lo fija en todos
# los entornos.
PASSWORD_LOG_N=<logN de scrypt, 10-22; default 17 en produccion, 10 en dev> <number>

#dev
ADMINER_PORT=<puerto de adminer> <number>

#rate limit
#Valores habituales con la ventana de 60000 ms:
#  1000  desarrollo y tests, para que el limite no estorbe
#   100  API publica de uso general
#    10  formularios de login o registro, contra la fuerza bruta
THROTTLE_TTL=<ventana en milisegundos, default=60000> <number>
THROTTLE_LIMIT=<peticiones por ventana, default=10> <number>
