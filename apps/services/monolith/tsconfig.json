{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false
  },
  // `scripts/` entra en el typecheck del editor pero NO en `tsconfig.build.json`,
// que solo incluye `src`: un script de desarrollo no tiene que acabar en la
// imagen de producción.
"include": ["src/**/*", "test/**/*", "scripts/**/*", "jest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
