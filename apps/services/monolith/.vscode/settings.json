{
  // --- Indentación: 2 espacios, siempre ---
  // detectIndentation es la clave: por defecto VSCodium adivina la sangría
  // leyendo el contenido de cada archivo, y esa suposición le gana a tabSize.
  // Por eso un archivo ya escrito con 4 espacios seguía en 4.
  "editor.detectIndentation": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,

  // --- Comillas simples en los auto-imports ---
  // Afecta a lo que ESCRIBE el editor: auto-imports, quick fixes, refactors.
  // "auto" (el default) las deduce del archivo; forzarlo a "single" evita
  // que un archivo con comillas dobles siga generando dobles.
  "typescript.preferences.quoteStyle": "single",
  "javascript.preferences.quoteStyle": "single",

  // --- Formateo al guardar ---
  // eslint-plugin-prettier ya está configurado en eslint.config.mjs, así que
  // ESLint aplica las reglas de .prettierrc (singleQuote, trailingComma) al
  // arreglar. Un solo motor, una sola fuente de verdad.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,

  // Excluir del explorador y de la búsqueda lo que no se edita a mano.
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true
  }
}
